--- /dev/null
+++ b/tests/api/test_decorated_tool_exposure.py
@@ -0,0 +1,46 @@
+"""Decorated Agent tools must be part of the model-facing tool surface.
+
+Bug: Agent(tools=[@tool fn]) registered the callable on ToolRegistry only.
+model_provider_specs / get_model_exposure_specs never listed it, so the
+provider payload was sent with zero user tools. Plain names also failed
+manifest validation (non-canonical model_tool_id).
+"""
+from openminion import tool
+from openminion.api.agent import Agent
+from openminion.modules.tool.exposure import get_model_exposure_specs
+from openminion.modules.tool.registry import ToolRegistry
+
+
+def test_plain_decorated_tool_is_exposed_for_the_run_only():
+    @tool(description="Look up an order by id")
+    def lookup_order(order_id: str) -> dict:
+        return {"order_id": order_id}
+
+    assert lookup_order.tool_decl.name == "plugin.user.lookup_order"
+
+    agent = Agent(
+        tools=[lookup_order],
+        forced_tools=["lookup_order"],
+        instructions="Look up the order with the tool.",
+    )
+    assert agent.forced_tools == ["plugin.user.lookup_order"]
+
+    registry = ToolRegistry()
+    registered = agent._register_tools_for_run(registry)
+    assert registered == ["plugin.user.lookup_order"]
+    specs = get_model_exposure_specs(registry)
+    matched = [spec for spec in specs if spec.name == "plugin.user.lookup_order"]
+    assert matched, [spec.name for spec in specs]
+    properties = (matched[0].parameters or {}).get("properties") or {}
+    assert "order_id" in properties
+
+    agent._unregister_tools(registry, registered)
+    leftover = [spec.name for spec in get_model_exposure_specs(registry)]
+    assert "plugin.user.lookup_order" not in leftover
+
+    # A second run must not collide with a manifest left behind by the first.
+    registered_again = agent._register_tools_for_run(registry)
+    assert "plugin.user.lookup_order" in {
+        spec.name for spec in get_model_exposure_specs(registry)
+    }
+    agent._unregister_tools(registry, registered_again)

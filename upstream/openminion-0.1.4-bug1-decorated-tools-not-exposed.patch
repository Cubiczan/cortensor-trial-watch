+def _model_visible_tool_name(name: str) -> str:
+    """Return a model tool id validation will accept.
+
+    Built-in ids and ``mcp.`` / ``plugin.`` names pass through. A plain function
+    name such as ``lookup_order`` is not a canonical model tool id, so manifests
+    reject it and the exposure service hides it. Namespace those automatically.
+    """
+    from openminion.modules.tool.contracts.model_ids import is_valid_model_tool_id
+
+    token = str(name or "").strip()
+    if token and is_valid_model_tool_id(token):
+        return token
+    safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", token).strip("._") or "tool"
+    return f"plugin.user.{safe}"
+

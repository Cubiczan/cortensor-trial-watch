+def _rewrite_forced_tools(forced: list[str], exposed: list[str]) -> list[str]:
+    """Map a plain forced name onto the auto-namespaced tool id when needed."""
+    known = set(exposed)
+    rewritten: list[str] = []
+    for raw in forced:
+        if raw in known:
+            rewritten.append(raw)
+            continue
+        prefixed = f"plugin.user.{raw}"
+        rewritten.append(prefixed if prefixed in known else raw)
+    return rewritten
+
